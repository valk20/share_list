{
  "uid": "listshare-overview",
  "title": "ListShare Overview",
  "schemaVersion": 39,
  "time": { "from": "now-30d", "to": "now" },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "New signups per day",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "mysql", "uid": "mysql_listshare_ds" },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '1d'), COUNT(id) AS signups FROM users WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Lists created per day",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "mysql", "uid": "mysql_listshare_ds" },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '1d'), SUM(is_public) AS public, SUM(NOT is_public) AS private FROM lists WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Item completion rate",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 5 },
      "datasource": { "type": "mysql", "uid": "mysql_listshare_ds" },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT ROUND(100 * AVG(is_completed), 1) AS completion FROM list_items"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Forked lists",
      "gridPos": { "x": 6, "y": 8, "w": 6, "h": 5 },
      "datasource": { "type": "mysql", "uid": "mysql_listshare_ds" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT COUNT(*) AS forks FROM lists WHERE forked_from_id IS NOT NULL"
        }
      ]
    },
    {
      "id": 5,
      "type": "barchart",
      "title": "Top categories",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 10 },
      "datasource": { "type": "mysql", "uid": "mysql_listshare_ds" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT COALESCE(category, 'none') AS category, COUNT(*) AS lists FROM lists GROUP BY 1 ORDER BY 2 DESC LIMIT 10"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Likes and comments per day",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "mysql", "uid": "mysql_listshare_ds" },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '1d'), COUNT(*) AS likes FROM list_likes WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1"
        },
        {
          "refId": "B",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '1d'), COUNT(*) AS comments FROM list_comments WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1"
        }
      ]
    }
  ]
}
